# Скопируйте этот файл в .env и заполните своими данными

# ── MySQL ──────────────────────────────────────────────
MYSQL_HOST=localhost
# MYSQL_HOST=mysql # для прода/полного запуска через Docker
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=site_assistant

# ── Qdrant ─────────────────────────────────────────────
QDRANT_HOST = localhost
# QDRANT_HOST = qrant # для прода/полного запуска через Docker
QDRANT_PORT = 6333

# ── Server ─────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false
OPENAI_PROXY=socks5://your_poxy_here
